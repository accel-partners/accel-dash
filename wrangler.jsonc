// Cloudflare テスト版（accel-dash-test）の設定。本番（Vercel）には影響しない。
// 定期実行（Cron）は書かない：MF 同期・未入金通知は Vercel 側だけで動かす。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accel-dash-test",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare の画面で入れた変数（NEXT_PUBLIC_SUPABASE_URL など）をデプロイのたびに消さない
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_DEPLOY_TARGET": "cloudflare-test"
  },
  "observability": {
    "enabled": true
  }
}
