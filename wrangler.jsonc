// Cloudflare 版 accel-dash の設定（Worker 名は accel-dash-test のまま。2026-10-23 から accel-dash.com の本番）。
// 定期実行（MF 同期・未入金通知）は Cloudflare で動かす。入口は cf-worker.js。vercel.json の crons は外した。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "accel-dash-test",
  "main": "cf-worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 決まった時刻に API を呼ぶ（UTC。cf-worker.js の JOBS と同じ式にする）
  "triggers": {
    "crons": ["0 1 * * *", "30 1 * * *"]
  },
  // MF 同期（売上約 2,000 件の読み込み）で止まらないよう、CPU の上限を最大（5分）にしておく
  "limits": {
    "cpu_ms": 300000
  },
  // Cloudflare の画面で入れた変数（NEXT_PUBLIC_SUPABASE_URL など）をデプロイのたびに消さない
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
